{
  "name": "food-scanner-server",
  "version": "1.0.0",
  "description": "Production Fastify backend for AI Food Intelligence Platform",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:generate": "npm run build && drizzle-kit generate:pg",
    "db:migrate": "tsx src/db/migrate.ts",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "keywords": [
    "food-scanner",
    "fastify",
    "typescript",
    "drizzle-orm",
    "icmr-nin",
    "fssai"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/sensible": "^5.5.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.30.4",
    "fastify": "^4.26.2",
    "google-auth-library": "^9.7.0",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.1",
    "postgres": "^3.4.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.28",
    "drizzle-kit": "^0.20.14",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2"
  }
}
