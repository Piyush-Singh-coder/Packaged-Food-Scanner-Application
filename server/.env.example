# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug

# Security & Authentication
JWT_SECRET=super-secure-jwt-secret-key-at-least-32-chars-long-here
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
COOKIE_SECRET=super-secure-cookie-secret-key-at-least-32-chars

# Google OAuth (Native ID Token verification)
GOOGLE_CLIENT_ID=your-google-client-id-from-google-cloud-console.apps.googleusercontent.com

# Database (Neon PostgreSQL connection string)
DATABASE_URL=postgres://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Redis Cache (Optional for local dev, used for sub-15ms barcode lookups)
REDIS_URL=redis://localhost:6379
